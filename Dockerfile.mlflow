FROM python:3.12.6-slim

WORKDIR /app

RUN pip install --no-cache-dir mlflow==3.15.1

COPY . .

# This directory is mounted from the project by Docker Compose.
RUN mkdir -p /app/mlruns

EXPOSE 5000

CMD ["mlflow", "server", \
    "--host", "0.0.0.0", \
    "--port", "5000", \
    "--backend-store-uri", "sqlite:////app/mlflow.db", \
    "--default-artifact-root", "file:///app/mlruns", \
    "--allowed-hosts", "localhost,localhost:*,127.0.0.1,127.0.0.1:*,mlflow,mlflow:*"]
